model VehicleDriver {
  TenantId String @db.VarChar(36)
  VehicleDriverId String @id @default(uuid()) @db.VarChar(36)
  Status String @db.VarChar(15)
  Name String
  MobileNo String? @db.VarChar(50)
  LicenseNo String? @db.VarChar(50)
  ImageUrl String?
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @default(now())
  CreatedByUsername String?
  UpdatedByUsername String?
  LineUserId String?
  Vehicle Vehicle[]
  IncomeVehicle IncomeVehicle[]
  DriverJobs DriverJob[]
  @@index([TenantId])
  @@index([VehicleDriverId])
}

model DriverJob {
  DriverJobId String @id @default(uuid()) @db.VarChar(36)
  TenantId String @db.VarChar(36)
  JobNo Int?
  VehicleDriverId String? @db.VarChar(36)
  VehicleDriver VehicleDriver? @relation(fields: [VehicleDriverId], references: [VehicleDriverId])
  VehicleId String? @db.VarChar(36)
  VehicleNo String?
  Origin String
  Destination String
  ScheduledAt DateTime?
  Note String?
  Status String @db.VarChar(15) @default("pending")
  Price Decimal? @db.Decimal(10,2) // job fare; recorded as income when the job is done
  CustomerName String? // who is billed for the job
  BillNo String? @db.VarChar(20) // set once the job is on a DriverBill
  Bill DriverBill? @relation(fields: [BillNo], references: [BillNo])
  RespondedAt DateTime?
  CreatedByUsername String?
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @default(now()) @updatedAt
  @@index([TenantId])
  @@index([VehicleDriverId])
  @@index([Status])
  @@index([TenantId, JobNo])
  @@index([BillNo])
}

// Billing note (ใบวางบิล, no VAT) grouping finished jobs of one customer.
model DriverBill {
  BillNo String @id @db.VarChar(20) // BL<yymm>-<seq>; the key makes a duplicate number fail
  TenantId String @db.VarChar(36)
  CustomerName String
  Total Decimal @db.Decimal(12,2)
  CreatedByUsername String
  CreatedAt DateTime @default(now())
  Jobs DriverJob[]
  @@index([TenantId, CreatedAt])
}

model LineCommand {
  LineCommandId String @id @default(uuid()) @db.VarChar(36)
  TenantId String @db.VarChar(36)
  LineUserId String
  Role String @db.VarChar(15)
  RawText String
  ParsedAction String?
  ResultStatus String @db.VarChar(15)
  CreatedAt DateTime @default(now())
  @@index([TenantId])
  @@index([LineUserId])
}

model VehicleStatus {
  TenantId String @db.VarChar(36)
