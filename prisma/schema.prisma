  SourceLabel String?
  ReceiveDate DateTime?
  DateTime DateTime @default(now())
  Time String
  WorkOrderNumber String @db.VarChar(50)
  InvoiceNumber String @db.VarChar(50)
  AmountReceive Decimal @db.Decimal(10,2) @default(0)
  VehicleDriver VehicleDriver? @relation(fields: [VehicleDriverId], references: [VehicleDriverId])
  VehicleDriverId String? @db.VarChar(36)
  PaymentStatus PaymentStatus? @relation(fields: [PaymentStatusId], references: [PaymentStatusId])
  PaymentStatusId String? @db.VarChar(36)
  // Set when the income was created from a finished driver job (one per job).
  DriverJobId String? @unique @db.VarChar(36)
  @@index([VehicleId])
  @@index([IncomeVehicleId])
  @@index([TenantId])
}

