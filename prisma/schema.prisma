  InsurancePay Decimal @db.Decimal(10,2)
  CompanyPay Decimal @db.Decimal(10,2)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @default(now())
  CreatedByUsername String?
  UpdatedByUsername String?
  VehicleId String @db.VarChar(36)
  Vehicle Vehicle @relation(fields: [VehicleId], references: [VehicleId])
  @@index([VehicleId])
  @@index([RepairVehicleId])
}

model GasolineCost {
  GasolineCostId String @id @default(uuid()) @db.VarChar(36)
  Status String @db.VarChar(15)
  Item String
  TaxInvoiceNumber String? @db.VarChar(100)
  Liters Decimal @db.Decimal(10,2)
  Amount Decimal @db.Decimal(10,2)
  OdometerStart Decimal @db.Decimal(12,2)
  OdometerEnd Decimal @db.Decimal(12,2)
  Distance Decimal? @db.Decimal(12,2)
  ReceiverName String?
  // Photo of the bill (/uploads/...), kept from the bill-photo import or the add form.
  BillUrl String?
  // Photo of the odometer / hour meter at this fill (bill-photo import).
  OdometerUrl String?
  ExpressOrder ExpressFuelOrder?
  // Checked one by one at /fleet/fuel/audit: "ok" | "problem" (with a note), null = not
  // checked. Any later edit clears it, since the check was of the old values.
  AuditStatus String? @db.VarChar(10)
  AuditNote String?
  AuditedBy String?
  AuditedAt DateTime?
  // Identity of the spreadsheet row this came from, fixed at import time so a
  // row edited on the web is still recognised when the same file is re-imported.
  ImportKey String? @db.VarChar(200)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @default(now())
  CreatedByUsername String?
  UpdatedByUsername String?
  DateTime DateTime
  VehicleId String @db.VarChar(36)
  Vehicle Vehicle @relation(fields: [VehicleId], references: [VehicleId])
  @@index([VehicleId])
  @@index([GasolineCostId])
  @@index([ImportKey])
}

