  DupRows Int @default(0)
  DupSum Decimal @db.Decimal(16,2) @default(0)
  ExistRows Int @default(0)
  ExistSum Decimal @db.Decimal(16,2) @default(0)
  @@index([TenantId])
}

// ======================================================================
// == FUEL BILL CHECKER (from โปรแกรมนำมัน) =============================
// ======================================================================

model FuelBill {
  id Int @id @default(autoincrement())
  lineUserId String
  employeeName String?
  imageUrl String?
  imageHash String?
  receiptNo String?
  station String?
  billDate String? // YYYY-MM-DD as read from the receipt
  billTime String? // HH:MM 24h
  fuelType String?
  liters Decimal? @db.Decimal(16,2)
  pricePerLiter Decimal? @db.Decimal(16,2)
  total Decimal? @db.Decimal(16,2)
  plate String?
  status String @default("ok") // ok | suspect | extract_failed
  suspectReasons String?
  createdAt DateTime @default(now())
  // Company vehicle the plate on the receipt resolved to (null = unmatched).
  VehicleId String? @db.VarChar(36)
  Vehicle Vehicle? @relation(fields: [VehicleId], references: [VehicleId])
  @@index([VehicleId])
  @@index([lineUserId])
  @@index([imageHash])
  @@index([receiptNo])
}

// Generic key/value app config (fuel line_admin_id, feature toggles, etc.)
model AppSetting {
  key String @id
  value String?
  updatedAt DateTime @default(now()) @updatedAt
}

// ======================================================================
// == DEBT / AR (from dhevadebt) ========================================
// ======================================================================

model DebtVersion {
  id String @id @default(cuid())
  fileName String
  uploadedAt DateTime @default(now())
  rowCount Int @default(0)
  totalAmount Decimal @db.Decimal(16,2) @default(0)
  isCurrent Boolean @default(false)
  records DebtRecord[]
  @@index([isCurrent])
}

model DebtRecord {
  id String @id @default(cuid())
  versionId String
  version DebtVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  docNo String
  docType String
  date String? // ISO YYYY-MM-DD (kept as string to match the source module)
  customer String
  project String
  taxId String
  dueDate String? // ISO YYYY-MM-DD
  branch String
  value Decimal @db.Decimal(16,2) @default(0)
  vat Decimal @db.Decimal(16,2) @default(0)
  total Decimal @db.Decimal(16,2) @default(0)
  depositRef String
  status String // Thai status union: รอวางบิล | วางบิลแล้ว | เปิดบิลแล้ว | ชำระแล้ว | ยกเลิก
  salesperson String
  // Sum of DebtPayment.amount. Payments belong to one uploaded version, so a
  // new Excel upload starts every record at 0 again (the file wins).
  paid Decimal @db.Decimal(16,2) @default(0)
  payments DebtPayment[]
  @@index([versionId])
  @@index([docNo])
}

model DebtPayment {
  id String @id @default(cuid())
  recordId String
  record DebtRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  amount Decimal @db.Decimal(16,2)
  paidAt String // ISO YYYY-MM-DD
  method String // โอน | เงินสด | เช็ค | อื่นๆ
  note String @default("")
  slipUrl String?
  createdBy String
  createdAt DateTime @default(now())
  @@index([recordId])
}

// Collection log. Keyed by docNo (not a version row) so the history survives
// a new Excel upload.
model DebtFollowUp {
  id String @id @default(cuid())
  docNo String
  customer String
  note String
  promiseDate String? // ISO YYYY-MM-DD: the customer said they would pay by then
  createdBy String
  createdAt DateTime @default(now())
  @@index([docNo])
  @@index([promiseDate])
}

// ======================================================================
// == ASSETS (equipment register + borrow/return log) ===================
// ======================================================================

model Asset {
  AssetId String @id @default(uuid()) @db.VarChar(36)
  TenantId String @db.VarChar(36)
  Tenant Tenant @relation(fields: [TenantId], references: [TenantId])
  Name String
  Category String
  Code String?
  DefaultLocation String?
  Note String?
  Inactive Boolean @default(false)
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @default(now())
  CreatedByUsername String?
  UpdatedByUsername String?
  Loans AssetLoan[]
  @@index([TenantId])
}

model AssetLoan {
  AssetLoanId String @id @default(uuid()) @db.VarChar(36)
  AssetId String @db.VarChar(36)
  Asset Asset @relation(fields: [AssetId], references: [AssetId])
  BorrowerName String
  Location String
  BorrowedAt DateTime @default(now())
  DueAt DateTime? // expected return date; overdue loans are reminded daily
  ReturnedAt DateTime?
  Note String?
  CreatedByUsername String?
  UpdatedByUsername String?
  @@index([AssetId])
  @@index([AssetId, ReturnedAt])
}

// ======================================================================
// == PURCHASE ORDERS (copied from Express, approved here) ===============
// ======================================================================

// Read-only copy of an Express PO (POPR + POPRIT), pushed by
// scripts/express-po-sync.mjs from the office PC. The Express columns are
// overwritten on every sync; the Approval* columns are ours and Express never
// sees them. ContentHash covers what an approver signs off on (supplier, lines,
// prices, totals) but not receiving progress, so goods arriving keeps the
// approval while a changed price or quantity sends the PO back to pending.
model PurchaseOrder {
  PurchaseOrderId String @id @default(uuid()) @db.VarChar(36)
  TenantId String @db.VarChar(36)
  PoNo String @db.VarChar(20)
  PoDate DateTime? @db.Date
  SupplierCode String
  SupplierName String
  DepCode String
  DepName String
  NetAmt Decimal @db.Decimal(16,2) @default(0)
  DocStat String @db.VarChar(1) // Express: N open (awaiting goods), M complete, C cancelled
  Data Json // the whole PO as sent by the sync (header, supplier, lines)
  ContentHash String @db.VarChar(40)
  MissingInExpress Boolean @default(false) // deleted in Express since the last sync
  R3DocNo String? @db.VarChar(20) // PK only: the R3 (ตั้งหนี้บัตรเครดิต) in Express for this PO (read back by the sync)
  // PK only, creating that R3 from the office PC (scripts/express-po-sync.mjs):
  // queued (approved, PC will write it) | waiting (no H3 in Express yet) | error (see R3Error; admin retries)
  R3Status String? @db.VarChar(10)
  R3Error String?
  R3UpdatedAt DateTime?
  SyncedAt DateTime @default(now())
  ApprovalStatus String? @db.VarChar(10) // null pending | approved | rejected
  ApprovalNote String?
  ApprovedBy String?
  ApprovedAt DateTime?
  @@unique([TenantId, PoNo])
  @@index([TenantId, PoDate])
  @@index([TenantId, ApprovalStatus])
}

// A fuel bill saved on the web (GasolineCost) that staff asked to book in
// Express: the office PC writes a PK (ใบสั่งซื้อ-น้ำมัน(ใหม่)) and, once an
// admin approves the PK, for an ordinary vehicle the H3 that receives it
// (cash purchase on the card, input VAT); the R3 queue then adds that H3 to the
// R3 of the bill's date. The bill's figures are copied at save time so a later
// edit of the fuel row cannot change what Express books.
model ExpressFuelOrder {
  ExpressFuelOrderId String @id @default(uuid()) @db.VarChar(36)
  TenantId String @db.VarChar(36)
  GasolineCostId String @unique @db.VarChar(36)
  GasolineCost GasolineCost @relation(fields: [GasolineCostId], references: [GasolineCostId])
  // queued (PK to write) | pk (PK written, waiting for approval) | h3 (approved,
  // H3 to write) | done | error (no PkNo: the PK failed) | cancelled
  Status String @db.VarChar(10)
  WithH3 Boolean // false: the PK only, staff key the H3 (stock items such as SY140)
  SupplierCode String @db.VarChar(10)
  ItemCode String @db.VarChar(20)
  DepCode String @db.VarChar(4)
  Date DateTime @db.Date
  Invoice String @db.VarChar(15) // tax invoice number: H3 "เลขที่บิล" and the VAT report
  Liters Decimal @db.Decimal(10,2)
  Price Decimal @db.Decimal(10,4) // per litre, as on the bill
  Amount Decimal @db.Decimal(12,2) // including VAT
  PkNo String? @db.VarChar(12)
  H3No String? @db.VarChar(12)
  Error String?
  RequestedBy String
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @default(now()) @updatedAt
  @@index([TenantId, Status])
}

// ======================================================================
// == AUDIT LOG (before/after of money-related changes) =================
// ======================================================================

model AuditLog {
  AuditLogId String @id @default(uuid()) @db.VarChar(36)
  TenantId String @db.VarChar(36)
  Entity String @db.VarChar(60) // "InstallmentsVehicle", "DebtRecord", ...
  EntityId String @db.VarChar(100)
  Action String @db.VarChar(30) // create | update | delete | pay | ...
  Before Json?
  After Json?
  Username String?
  CreatedAt DateTime @default(now())
  @@index([TenantId, CreatedAt])
  @@index([Entity, EntityId])
}
